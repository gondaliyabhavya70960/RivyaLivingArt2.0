.vercel

# typescript
*.tsbuildinfo

# prisma
/src/generated

# IDE
.idea
.vscode/*
!.vscode/extensions.json

# dev-only local media uploads
/public/uploads

# agent skills installed via `npx skills add` (regenerable third-party tooling)
/.agents/
/skills-lock.json

# .claude/ scaffolding is committed team infrastructure (DESIGN.md Part E3);
# only per-machine local state stays out
/.claude/settings.local.json
screenshots/

# Agent scratch space — screenshots and probe scripts, never committed
.scratch/
.studio-shots/
shots/

# §15.5 cull workspace — candidate downloads + contact sheet
.media-v3-candidates/
.media-v3-video-tmp/

# Generated by the audit scripts — regenerate with `node scripts/audit-crawl.mjs`
# and `node scripts/audit-lighthouse.mjs` rather than committing a snapshot. The
# committed lh-summary.json had gone stale against pre-rename routes (D24).
audit/crawl-report.json
audit/lh-summary.json

# Playwright MCP session scratch — console logs and page snapshots from a
# browser session, committed once by accident (D24).
.playwright-mcp/
