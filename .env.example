DATABASE_URL=                # AUTO-INJECTED by Neon native integration; pull locally with `vercel env pull`
DATABASE_URL_UNPOOLED=       # optional — unpooled/direct connection used by `prisma.config.ts` for migrations
AUTH_SECRET=
# Required when deploying anywhere other than Vercel (Auth.js host trust);
# without it every auth check fails with UntrustedHost.
AUTH_TRUST_HOST=true
AUTH_URL=https://www.rivyalivingart.com
ADMIN_EMAIL=gondaliyabhavya70960@gmail.com
ADMIN_PASSWORD=              # used by seed script only
BLOB_READ_WRITE_TOKEN=       # AUTO-INJECTED when Vercel Blob store is connected
CRON_SECRET=                 # optional — secret bearer token for Vercel cron endpoints (/api/cron/*)
RESEND_API_KEY=              # optional — Resend API key (contact + password-reset email)
RESEND_EMAIL_DOMAIN=         # optional — a Resend-verified domain, e.g. bhavyagondaliya.co.in → sends as studio@<domain>
RESEND_FROM=                 # optional — e.g. "Rivya Living Art <studio@rivyalivingart.com>"
EMAIL_FROM=                  # optional — alias/override for sender address (else Resend sandbox)
GOOGLE_SERVICE_ACCOUNT_JSON= # optional — service-account JSON; enables direct Google Sheet sync from the Product Scraper
GOOGLE_SERVICE_ACCOUNT_KEY_B64= # optional — base64 of the service-account JSON (alias for the above; easier to paste as a secret)
SCRAPE_SHEET_ID=             # optional — the designated Google Sheet for scraped products
SHEET_ID=                    # optional — alias for SCRAPE_SHEET_ID
SCRAPER_USER_AGENT=          # optional — override the scraper User-Agent (defaults to a desktop-browser UA so stores don't 403 the crawler; set to a custom/identifying string if you prefer). robots.txt is honored regardless.
NEXT_PUBLIC_WHATSAPP_NUMBER=917096036250
NEXT_PUBLIC_SITE_URL=https://www.rivyalivingart.com
NEXT_PUBLIC_META_PIXEL_ID=    # optional — Meta Pixel ID; when set, loads the pixel (fires Contact on WhatsApp-CTA clicks). Enable only with a consent mechanism for your audience.
NEXT_PUBLIC_GA_ID=            # optional — GA4 measurement ID (G-XXXXXXX); when set, loads gtag.js.
