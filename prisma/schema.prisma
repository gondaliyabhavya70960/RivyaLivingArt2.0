// Rivya Living Art — full data model (CONTEXT.md §3, verbatim structure)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ————————————————————— Auth & staff —————————————————————

enum Role {
  ADMIN
  EDITOR
}

model User {
  id               String        @id @default(cuid())
  name             String
  email            String        @unique
  hashedPassword   String
  role             Role          @default(EDITOR)
  /// Bumped on delete/demote/password-reset to invalidate outstanding JWT
  /// sessions immediately (SEC-106). The value is embedded in the token at
  /// sign-in and re-checked in requireStaff().
  tokenVersion     Int           @default(0)
  createdAt        DateTime      @default(now())
  /// Self-service password reset — SHA-256 of a single-use token, cleared on use.
  resetTokenHash   String?
  resetTokenExpiry DateTime?
  activityLogs     ActivityLog[]
}

// ————————————————————— Catalog —————————————————————

model Category {
  id           String      @id @default(cuid())
  name         String
  slug         String      @unique
  image        String?
  description  String?
  order        Int         @default(0)
  /// Per-locale { name, description } overrides; base is English (I3).
  translations Json?
  /// Owner SEO overrides; null falls back to the name-derived metadata.
  seoTitle       String?
  seoDescription String?
  /// false takes the shelf off every public surface without deleting it.
  visible        Boolean     @default(true)
  products     Product[]
  portfolios   Portfolio[]
  posts BlogPost[] @relation("BlogPostCollection")
}

enum ContentStatus {
  DRAFT
  /// Written, awaiting approval. Every public reader treats it as DRAFT.
  REVIEW
  PUBLISHED
t  /// Retired but kept. Never public, never orderable.
  ARCHIVED
}

model Product {
  id             String               @id @default(cuid())
  title          String
  /// Short editorial name for cards and the PDP hero. Null → storefront
  /// derives one from `title` (cut at the first qualifier separator). The
  /// full `title` stays canonical for SEO metadata, JSON-LD and WhatsApp.
  displayName    String?
  slug           String               @unique
  shortTagline   String?
  description    String               @default("")
  priceMin       Int?
  priceMax       Int?
  showPrice      Boolean              @default(true)
  timeline       String?
  materials      String?
  dimensions     String?
  occasions      Json                 @default("[]") // string array
  /// Aesop-style lexical rows (benchmark gap 4): [{ label, value }] shown in
  /// the PDP spec sheet — labels the owner's own ("Suited to", "Pour story").
  lexical        Json                 @default("[]")
  /// Cross-tier provenance (benchmark gap 3): the actual supplies/print
  /// products this piece is made with; the reverse side surfaces "What this
  /// creates" on the supply's PDP. Owner-linked in the studio, never guessed.
  madeWith       Product[]            @relation("ProductProvenance")
  usedIn         Product[]            @relation("ProductProvenance")
  careNotes      String?              @db.Text
  status         ContentStatus        @default(DRAFT)
  featured       Boolean              @default(false)
  videoUrl       String?
  model3dUrl     String?
  categoryId     String
  category       Category             @relation(fields: [categoryId], references: [id])
  seoTitle       String?
  seoDescription String?
  ogImage        String?
  /// Per-locale field overrides, shape { [locale]: { field: value } }. The base
  /// row is English (default locale); missing locales/fields fall back to it (I3).
  translations   Json?
  /// Set by the Product Scraper — publish is BLOCKED while true.
  needsRewrite   Boolean              @default(false)
  /// Scraper dedupe keys: importSource = source registry key, importRef =
  /// the competitor's external product id. Re-importing the same pair UPDATES
  /// this product instead of creating a duplicate.
  importSource   String?
  importRef      String?
  /// Owner-sheet tier (1 owner · 2 resin goods · 3 supplies · 4 3D-print).
  /// Null for products created in the studio by hand.
  ///
  /// THIS IS PROVENANCE, NOT SIZE — where the row came from. The owner's
  /// three-tier product architecture lives in `sizeTier` below, on its own
  /// column, because this one is an indexed Int the shop's default sort and
  /// nine other readers already depend on.
  tier           Int?
  /// The owner's three-tier product architecture
  /// (docs/plan/07-three-tier-architecture.md): what a finished piece IS.
  ///
  /// NULLABLE ON PURPOSE. Three writers create products without passing the
  /// studio form — the scraper's promote, Bulk Import, and `tier-fill.ts` on
  /// every deploy — so a NOT NULL DEFAULT would both break backward
  /// compatibility and invent the answer. "Mandatory" is enforced where a
  /// human is present: the studio refuses to PUBLISH an untiered product.
  sizeTier       ProductSizeTier?
  /// Sheet `status` mapped: active → true, out_of_stock → false.
  inStock        Boolean              @default(true)
  /// contentHash of the imported sheet row — lets re-imports skip unchanged
  /// rows so a 4,000-product deploy pass stays fast.
  sourceHash     String?
  /// H5 merge-protection: set by every studio save. The sheet importer
  /// refreshes availability (inStock/sourceHash) on touched rows but never
  /// overwrites owner-edited content or images.
  ownerTouched   Boolean              @default(false)
  /// When the studio last saved this row. `ownerTouched` says THAT a human
  /// edited it; this says WHEN, which is what conflict detection needs to
  /// decide whether the sheet or the studio has the newer version.
  studioEditedAt DateTime?
  /// The final-list blessing. CONFIRMED_PRODUCTS is exactly the set of rows
  /// where this is non-null — never "everything scraped", never "everything
  /// in the studio". Only an explicit operator action sets it.
  confirmedAt    DateTime?
  /// Who blessed it, for the audit trail. Kept as an id rather than a
  /// relation: a confirmation outlives the staff account that made it, and
  /// deleting a user must not erase the record that someone approved this.
  confirmedById  String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  images         ProductImage[]
  customFields   CustomizationField[]
  inquiries      Inquiry[]
  testimonials   Testimonial[]
  /// Synthetic Content Lab row. Public readers add `isDemo: false` unless the owner shows demo content.
  isDemo Boolean @default(false)
  importConflicts ImportConflict[]

  @@unique([importSource, importRef])
  @@index([categoryId, status])
  @@index([status, featured])
  @@index([status, createdAt])
  @@index([status, priceMin])
  @@index([tier, status])
  @@index([sizeTier, status])
  // The confirmed list is read as a whole every time it is synced.
  @@index([confirmedAt])
}

/// The owner's three-tier product architecture, supplied 2026-09-15 and in
/// force (docs/plan/07-three-tier-architecture.md). Three customer intents
/// with different price ladders, customization depth and interface density —
/// NOT three filters on one grid.
///
///   LARGE_FORMAT   Collectible Furniture & Spatial Art
///   MEDIUM_FORMAT  Memory & Celebration Art
///   SMALL_FORMAT   Personal Art & Gifting
///
/// Deliberately NOT the same type as `ScrapeTier`, which shares these three
/// names and means something else: which supplier list we went looking in. A
/// large-format supplier sells small pieces too.
enum ProductSizeTier {
  LARGE_FORMAT
  MEDIUM_FORMAT
  SMALL_FORMAT
}

/// What a product photograph shows, so the page can pick the in-room frame.
enum ProductImageRole {
  HERO
  DETAIL
  IN_ROOM
  PROCESS
}

model ProductImage {
  id        String  @id @default(cuid())
  url       String
  alt       String  @default("")
  order     Int     @default(0)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Null on every existing frame; the room-context band needs IN_ROOM.
  role ProductImageRole?

  @@index([productId])
}

enum FieldType {
  SELECT
  TEXT
  SWATCH
  SIZE
  NUMBER
  FILE
}

model CustomizationField {
  id        String    @id @default(cuid())
  productId String
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  label     String
  type      FieldType
  options   Json      @default("[]")
  required  Boolean   @default(false)
  helpText  String?
  order     Int       @default(0)

  @@index([productId])
}

// ————————————————————— Inquiries (WhatsApp orders) —————————————————————

enum InquirySource {
  PRODUCT
  CUSTOM_ORDER
  CONTACT
}

enum InquiryStatus {
  NEW
  CONTACTED
  /// Active back-and-forth before a price is set (audit OPS-01).
  DISCUSSION
  /// Price shared with the customer, awaiting their confirmation (C1
  /// pipeline; sits between CONTACTED and CONFIRMED).
  QUOTED
  CONFIRMED
  /// Confirmed and on the bench — poured, curing, finishing (audit OPS-01).
  IN_PRODUCTION
  DELIVERED
  /// Terminal resting place for dead/declined leads — kept for history
  /// instead of being deleted, and filtered out of the active pipeline (UIUX-610).
  CLOSED
  /// Terminal: the lead went quiet or declined after real discussion (audit
  /// OPS-01) — history kept, filtered from the active pipeline like CLOSED.
  LOST
}

model Inquiry {
  id                 String        @id @default(cuid())
  /// Human-readable reference (#RR-<number>) shared with the customer in the
  /// WhatsApp message and shown in the studio inbox (DESIGN.md E6 Phase 3).
  /// Postgres sequence — assigned on insert, never reused.
  number             Int           @unique @default(autoincrement())
  source             InquirySource
  productId          String?
  product            Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  customerName       String
  phone              String
  email              String?
  selections         Json          @default("{}")
  referenceImageUrls Json          @default("[]")
  budgetRange        String?
  timeline           String?
  notes              String        @default("")
  whatsappMessage    String        @db.Text
  /// SHA-256 of a one-time claim token returned to the submitter, required to
  /// re-read this inquiry from the public /whatsapp-order fallback (ENG-811).
  claimTokenHash     String?
  /// First-touch marketing attribution captured client-side (utm_*, referrer,
  /// landing) so per-lead acquisition survives the WhatsApp app switch (MKT-201).
  attribution        Json?
  /// Owner-entered pricing (C1: price is settled manually in WhatsApp —
  /// these fields RECORD that conversation, they never charge anything).
  quotedPrice        Int?
  finalPrice         Int?
  /// Internal notes for the studio team — never shown to the customer.
  staffNotes         String?       @db.Text
  status             InquiryStatus @default(NEW)
  createdAt          DateTime      @default(now())
  /// Synthetic Content Lab row. Public readers add `isDemo: false` unless the owner shows demo content.
  isDemo Boolean @default(false)

  @@index([status, createdAt])
}

// ————————————————————— Portfolio —————————————————————

model Portfolio {
  id             String           @id @default(cuid())
  title          String
  slug           String           @unique
  story          String           @default("")
  /// Case-study narrative (audit CS-01) — optional; the public piece page
  /// renders each section only when filled. brief = the client's ask,
  /// process = how it was made, clientNote = the client's words after
  /// delivery (real words only — the no-invented-content rule applies).
  brief          String?          @db.Text
  process        String?          @db.Text
  clientNote     String?          @db.Text
  /// Editorial card meta — the "Surat · 2026" line on archive tiles.
  location       String?
  year           Int?
  beforeImageUrl String?
  afterImageUrl  String?
  videoUrl       String?
  resultsMeta    Json             @default("{}") // ADM-style: type, material, size, timeline
  /// Per-locale { title, story } overrides; base row is English (I3).
  translations   Json?
  categoryId     String?
  category       Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  status         ContentStatus    @default(DRAFT)
  createdAt      DateTime         @default(now())
  images         PortfolioImage[]
  testimonials   Testimonial[]

  // Public list/home/sitemap filter by status + order by createdAt; the detail
  // "related" query filters categoryId + status. Product/BlogPost carry the
  // equivalent indexes; Portfolio had none, forcing scan+sort (PERF audit).
  /// Synthetic Content Lab row. Public readers add `isDemo: false` unless the owner shows demo content.
  isDemo Boolean @default(false)
  @@index([status, createdAt])
  @@index([categoryId, status])
}

model PortfolioImage {
  id          String    @id @default(cuid())
  url         String
  alt         String    @default("")
  /// What this frame shows, in the owner's words — printed beside the plate
  /// number. Distinct from `alt`: alt describes the picture for someone who
  /// cannot see it, a caption tells everyone something the picture does not.
  caption     String?
  /// Per-locale { caption } overrides; base is English (I3).
  translations Json?
  order       Int       @default(0)
  portfolioId String
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId])
}

// ————————————————————— Blog —————————————————————

model BlogCategory {
  id           String     @id @default(cuid())
  name         String
  slug         String     @unique
  /// Per-locale { name } overrides; base is English (I3). The slug is NOT
  /// translated — it is the URL the category filter is linked by.
  translations Json?
  posts        BlogPost[]
  /// Synthetic Content Lab row. Public readers add `isDemo: false` unless the owner shows demo content.
  isDemo Boolean @default(false)
}

model Tag {
  id           String     @id @default(cuid())
  name         String
  slug         String     @unique
  /// Per-locale { name } overrides; base is English (I3). Same reasoning as
  /// BlogCategory — the slug stays the URL, the name is what a reader sees.
  translations Json?
  posts        BlogPost[]
}

model BlogPost {
  id             String        @id @default(cuid())
  title          String
  slug           String        @unique
  excerpt        String        @default("")
  content        Json          @default("{}") // Tiptap JSON
  coverImage     String?
  authorName     String        @default("Rivya Living Art Studio")
  blogCategoryId String?
  blogCategory   BlogCategory? @relation(fields: [blogCategoryId], references: [id], onDelete: SetNull)
  tags           Tag[]
  status         ContentStatus @default(DRAFT)
  publishedAt    DateTime?
  seoTitle       String?
  seoDescription String?
  /// Per-locale { title, excerpt, content, seoTitle, seoDescription } overrides;
  /// base row is English (I3).
  translations   Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @default(now()) @updatedAt
  /// Synthetic Content Lab row. Public readers add `isDemo: false` unless the owner shows demo content.
  isDemo Boolean @default(false)
  /// Optional link to a shop collection, for the article's related-collections strip.
  categoryId String?
  category   Category? @relation("BlogPostCollection", fields: [categoryId], references: [id], onDelete: SetNull)
  @@index([categoryId])

  @@index([status, publishedAt])
}
